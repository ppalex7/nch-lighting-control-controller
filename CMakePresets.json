{
    "version": 4,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/${presetName}",
            "toolchainFile": "${sourceDir}/cubeide-gcc.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug-base",
            "hidden": true,
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release-base",
            "hidden": true,
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Host",
            "displayName": "Native PWM report",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/Host",
            "cacheVariables": {
                "PWM_REPORT_ONLY": true,
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Host",
            "configurePreset": "Host",
            "targets": [
                "pwm-report"
            ]
        }
    ]
}
